--- a/plugins/trace/scripts/variant/checks.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/plugins/trace/scripts/variant/checks.mjs	2026-10-31 18:07:45.261448365 +0000
@@ -0,0 +1,113 @@
+#!/usr/bin/env node
+// Required checks (eval variant v1, idea checks-block-pr): red blocks the PR,
+// enforced by a gate rather than prose. `node checks.mjs <event>`:
+//
+//   pre-tool-use  denies `gh pr create` and `gh pr ready` while the checks are red at HEAD.
+//   stop          blocks the agent from handing the PR over while they are red at HEAD:
+//                 once per head commit, so a head it cannot make green still lets it stop
+//                 and explain, and every new red head is refused again.
+//
+// The checks are the repository's full check suite (each step of package.json's
+// `check` script, run one by one so an early failure does not hide a later one),
+// run like CI: on a clean checkout of the commit. Red means a failure the
+// branch's base does not also have, so a check the base already fails, for a
+// reason outside the PR, does not trap the agent. Results are cached per
+// commit in git's own directory.
+//
+// Any input it does not expect, and any failure of its own, lets the call through.
+
+import { join } from 'node:path'
+
+import { baseOf, clip, compare, finish, git, readInput, readJson, resultsAt, stateDir, tracedRepo, writeJson } from './common.mjs'
+
+const PER_STEP_MS = 240_000
+// Inside the hook's 1200 s timeout in hooks.json, with room to clean up.
+const DEADLINE = Date.now() + 1_100_000
+// At a command's start, after quoted text is taken out, so a commit message or
+// comment body that mentions it is not taken for it.
+const PR_HANDOFF = /(?:^|[;&|({\n]|\$\()\s*(?:\w+=\S*\s+)*gh\s+pr\s+(?:create|ready)\b(?![^;&|\n]*--undo)/
+const QUOTED = /'[^']*'|"(?:[^"\\]|\\.)*"/g
+
+/** @param {Record<string, string>} scripts @returns {string[]} the full suite's steps */
+function steps(scripts) {
+  if (typeof scripts.check === 'string' && scripts.check.trim()) {
+    return scripts.check.split('&&').map(s => s.trim()).filter(Boolean)
+  }
+  return ['typecheck', 'test', 'lint', 'build']
+    .filter(s => typeof scripts[s] === 'string')
+    .map(s => (s === 'test' ? 'npm test' : `npm run ${s}`))
+}
+
+/**
+ * What is red at HEAD that is not red at its base, or null when nothing is
+ * (or when it cannot tell).
+ *
+ * @param {string} root
+ * @returns {{ head: string, text: string } | null}
+ */
+function redAtHead(root) {
+  const head = git(['rev-parse', 'HEAD'], root)
+  const state = stateDir(root)
+  if (!head || !state) return null
+  const base = baseOf(root, head)
+  if (!base || base === head) return null
+  const atHead = resultsAt(root, head, state, 'suite', steps, PER_STEP_MS, DEADLINE)
+  if (!atHead || atHead.steps.every(s => s.ok)) return null
+  const atBase = resultsAt(root, base, state, 'suite', steps, PER_STEP_MS, DEADLINE)
+  const { red, already } = compare(atHead.steps, atBase?.steps)
+  if (!red.length) return null
+  const parts = red.map(s => [
+    `\`${s.step}\` fails${s.fresh.length ? `, newly at this head:\n${s.fresh.slice(0, 15).map(l => `  ${l}`).join('\n')}` : ''}`,
+    `Its output ends:\n${clip(s.tail, 3_000)}`,
+  ].join('\n'))
+  const note = already.length ? `\n\nAlso failing at the branch's base, so not blocking: ${already.map(s => `\`${s}\``).join(', ')}.` : ''
+  return {
+    head,
+    text: `Required checks are red at ${head.slice(0, 7)} (run on a clean checkout of that commit; uncommitted changes are not part of it).\n\n${parts.join('\n\n')}${note}`,
+  }
+}
+
+/** @param {string | undefined} event @param {any} input @returns {object | null} */
+function output(event, input) {
+  if (!input) return null
+  if (event === 'pre-tool-use') {
+    if (input.tool_name !== 'Bash') return null
+    const command = String(input.tool_input?.command ?? '')
+    if (!PR_HANDOFF.test(command.replace(QUOTED, "''"))) return null
+    const root = tracedRepo(input.cwd)
+    const red = root && redAtHead(root)
+    if (!red) return null
+    return {
+      hookSpecificOutput: {
+        hookEventName: 'PreToolUse',
+        permissionDecision: 'deny',
+        permissionDecisionReason: `trace checks: ${red.text}\n\nReview step: make them green and commit before the PR is ready.`,
+      },
+    }
+  }
+  if (event === 'stop') {
+    const root = tracedRepo(input.cwd)
+    const red = root && redAtHead(root)
+    if (!red || !root) return null
+    const state = stateDir(root)
+    if (!state) return null
+    const asked = join(state, 'stop-blocked.json')
+    const heads = readJson(asked)
+    const seen = Array.isArray(heads) ? heads : []
+    if (seen.includes(red.head)) return null
+    writeJson(asked, [...seen, red.head])
+    return {
+      decision: 'block',
+      reason: `trace checks: ${red.text}\n\nReview step: the PR is not ready while its checks are red. Fix them, commit and push, and say in the progress comment what you ran and what it printed. If one cannot be made green in this PR, say why in the progress comment.`,
+    }
+  }
+  return null
+}
+
+let out = null
+try {
+  out = output(process.argv[2], readInput())
+} catch {
+  out = null
+}
+finish(out)
diff -ruN a/trace/scripts/variant/common.mjs b/trace/scripts/variant/common.mjs
--- a/plugins/trace/scripts/variant/common.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/plugins/trace/scripts/variant/common.mjs	2026-10-31 18:07:45.261495765 +0000
@@ -0,0 +1,215 @@
+// Helpers shared by the variant's check hooks (eval variant v1, family
+// A-verify-before-review). Plain Node, no dependencies. Every helper returns
+// null or false when it cannot tell, and the hooks then stay out of the way.
+
+import { spawnSync } from 'node:child_process'
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { isAbsolute, join, resolve } from 'node:path'
+
+/** @returns {any} the hook input on stdin, or null when it is not JSON */
+export function readInput() {
+  try {
+    const v = JSON.parse(readFileSync(0, 'utf8'))
+    return v && typeof v === 'object' ? v : null
+  } catch {
+    return null
+  }
+}
+
+/** Write the hook output, if any, and exit 0. @param {object | null} out */
+export function finish(out) {
+  if (out) process.stdout.write(JSON.stringify(out))
+  process.exit(0)
+}
+
+/**
+ * @param {string[]} args @param {string} cwd @param {number} [timeout]
+ * @returns {string | null} git's trimmed stdout, or null when git did not answer
+ */
+export function git(args, cwd, timeout = 10_000) {
+  const r = spawnSync('git', args, { cwd, encoding: 'utf8', timeout, maxBuffer: 16 * 1024 * 1024 })
+  return r.status === 0 && typeof r.stdout === 'string' ? r.stdout.trim() : null
+}
+
+/**
+ * The traced repository at `dir`: its root, when it has `.claude/trace.json`
+ * and the bypass is off. The plugin acts only in traced repositories.
+ *
+ * @param {unknown} dir @returns {string | null}
+ */
+export function tracedRepo(dir) {
+  if (process.env.TRACE_BYPASS === '1' || typeof dir !== 'string' || !isAbsolute(dir) || !existsSync(dir)) return null
+  const root = git(['rev-parse', '--show-toplevel'], dir)
+  return root && existsSync(join(root, '.claude/trace.json')) ? root : null
+}
+
+/** @param {string} root @returns {Record<string, string>} package.json's scripts, or none */
+export function scriptsOf(root) {
+  try {
+    const s = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8')).scripts
+    return s && typeof s === 'object' ? s : {}
+  } catch {
+    return {}
+  }
+}
+
+/** @param {string} root @returns {string | null} a directory for this variant's state, inside git's own directory */
+export function stateDir(root) {
+  const common = git(['rev-parse', '--git-common-dir'], root)
+  if (!common) return null
+  const dir = join(resolve(root, common), 'trace-variant-checks')
+  try {
+    mkdirSync(dir, { recursive: true })
+    return dir
+  } catch {
+    return null
+  }
+}
+
+/** @param {string} file @returns {any} */
+export function readJson(file) {
+  try {
+    return JSON.parse(readFileSync(file, 'utf8'))
+  } catch {
+    return null
+  }
+}
+
+/** @param {string} file @param {unknown} value */
+export function writeJson(file, value) {
+  try {
+    writeFileSync(file, JSON.stringify(value))
+  } catch {
+    // State is a convenience: without it the hook only repeats itself.
+  }
+}
+
+/**
+ * Runs one shell command, as a check.
+ *
+ * @param {string} command @param {string} cwd @param {number} timeout ms
+ * @returns {{ ok: boolean, output: string, timedOut: boolean }}
+ */
+export function runCheck(command, cwd, timeout) {
+  const r = spawnSync('sh', ['-c', command], {
+    cwd, encoding: 'utf8', timeout: Math.max(1, Math.floor(timeout)), maxBuffer: 64 * 1024 * 1024,
+    env: { ...process.env, FORCE_COLOR: '0', NO_COLOR: '1' },
+  })
+  const output = `${r.stdout ?? ''}${r.stderr ?? ''}`
+  const timedOut = /** @type {NodeJS.ErrnoException | undefined} */ (r.error)?.code === 'ETIMEDOUT'
+  if (r.error) return { ok: false, output: `${output}\n(${command}: ${r.error.message})`, timedOut }
+  return { ok: r.status === 0, output, timedOut }
+}
+
+/** @param {string} text @param {number} lines @returns {string} the last `lines` lines of `text` */
+export const tail = (text, lines) => text.trimEnd().split('\n').slice(-lines).join('\n')
+
+/** @param {string} text @param {number} max @returns {string} */
+export const clip = (text, max) => (text.length > max ? `${text.slice(0, max)}\n… (cut)` : text)
+
+/**
+ * The lines of a failing check's output that name what failed, made
+ * comparable across checkouts: no paths of the checkout, no timings, no
+ * positions or counters that move when lines above them do.
+ *
+ * @param {string} output @param {string} dir the checkout it ran in @returns {string[]}
+ */
+export function failureLines(output, dir) {
+  let real = dir
+  try {
+    real = realpathSync(dir)
+  } catch {
+    // The path as given is all there is to strip.
+  }
+  return [...new Set(output.split('\n')
+    .filter(l => /\bnot ok\b|✖|✘|\berror\b|\bfail(?:s|ed|ure)?\b/i.test(l))
+    // A runner's summary counts say how many, not which.
+    .filter(l => !/^\s*(?:ℹ|#)?\s*(?:tests|suites|pass|fail|cancelled|skipped|todo|duration_ms)\s+\d/i.test(l))
+    .filter(l => !/^\s*npm (?:error|ERR!)/.test(l))
+    .map(l => l.split(real).join('<checkout>').split(dir).join('<checkout>')
+      .replace(/\(\d+(?:\.\d+)?\s*m?s\)/g, '')
+      .replace(/\b\d+(?:\.\d+)?\s*m?s\b/g, '')
+      .replace(/\((\d+),(\d+)\)/g, '')
+      .replace(/:\d+:\d+/g, '')
+      .replace(/\bnot ok \d+/g, 'not ok')
+      .replace(/\s+/g, ' ')
+      .trim())
+    .filter(Boolean))]
+}
+
+/**
+ * @typedef {{ step: string, ok: boolean, lines: string[], tail: string }} StepResult
+ * @typedef {{ sha: string, steps: StepResult[] }} Results
+ */
+
+/**
+ * Runs `commandsOf(scripts)` on a clean checkout of `sha` (a detached
+ * worktree with a copy of the clone's dependencies, as CI's install would
+ * give it), or returns the result cached for that commit.
+ *
+ * @param {string} root @param {string} sha @param {string} state
+ * @param {string} label names the cache @param {(scripts: Record<string, string>) => string[]} commandsOf
+ * @param {number} timeout ms per command
+ * @param {number} deadline epoch ms by which to give up, so the hook returns before Claude Code kills it
+ * @returns {Results | null} null when it could not run them all in time
+ */
+export function resultsAt(root, sha, state, label, commandsOf, timeout, deadline) {
+  const file = join(state, `${label}-${sha}.json`)
+  const cached = readJson(file)
+  if (cached && cached.sha === sha && Array.isArray(cached.steps)) return cached
+  const dir = mkdtempSync(join(tmpdir(), 'trace-check-'))
+  try {
+    if (git(['worktree', 'add', '--detach', '--force', dir, sha], root, 60_000) === null) return null
+    // A copy, not a link: a check may assert that nothing it reads lies outside the tree.
+    if (existsSync(join(root, 'node_modules')) && !existsSync(join(dir, 'node_modules'))) {
+      cpSync(join(root, 'node_modules'), join(dir, 'node_modules'), { recursive: true, verbatimSymlinks: true })
+    }
+    const steps = []
+    for (const step of commandsOf(scriptsOf(dir))) {
+      const left = deadline - Date.now()
+      if (left < 5_000) return null
+      const r = runCheck(step, dir, Math.min(timeout, left))
+      // Cut short by the hook's own deadline, the check said nothing either way.
+      if (r.timedOut && left < timeout) return null
+      steps.push({ step, ok: r.ok, lines: r.ok ? [] : failureLines(r.output, dir), tail: r.ok ? '' : tail(r.output, 40) })
+    }
+    const result = { sha, steps }
+    writeJson(file, result)
+    return result
+  } finally {
+    git(['worktree', 'remove', '--force', dir], root, 60_000)
+    rmSync(dir, { recursive: true, force: true })
+    git(['worktree', 'prune'], root, 30_000)
+  }
+}
+
+/** @param {string} root @param {string} head @returns {string | null} the commit the branch grew from */
+export function baseOf(root, head) {
+  const remoteHead = git(['symbolic-ref', '--quiet', 'refs/remotes/origin/HEAD'], root)
+  for (const ref of [remoteHead, 'refs/remotes/origin/main', 'refs/remotes/origin/master', 'refs/heads/main', 'refs/heads/master']) {
+    if (!ref || git(['rev-parse', '--verify', '--quiet', `${ref}^{commit}`], root) === null) continue
+    const base = git(['merge-base', head, ref], root)
+    if (base) return base
+  }
+  return null
+}
+
+/**
+ * Splits the failing steps of `now` into those red only here (with the
+ * failure lines the base does not have) and those the base fails the same way.
+ *
+ * @param {StepResult[]} now @param {StepResult[] | undefined} atBase
+ * @returns {{ red: (StepResult & { fresh: string[] })[], already: string[] }}
+ */
+export function compare(now, atBase) {
+  const red = []
+  const already = []
+  for (const s of now.filter(x => !x.ok)) {
+    const b = atBase?.find(x => x.step === s.step)
+    const fresh = !b || b.ok ? s.lines : s.lines.filter(l => !b.lines.includes(l))
+    if (b && !b.ok && !fresh.length) already.push(s.step)
+    else red.push({ ...s, fresh })
+  }
+  return { red, already }
+}
diff -ruN a/trace/scripts/variant/typecheck-on-edit.mjs b/trace/scripts/variant/typecheck-on-edit.mjs
--- a/plugins/trace/scripts/variant/typecheck-on-edit.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/plugins/trace/scripts/variant/typecheck-on-edit.mjs	2026-10-31 18:07:45.261524526 +0000
@@ -0,0 +1,86 @@
+#!/usr/bin/env node
+// PostToolUse on Edit, Write and MultiEdit (eval variant v1, idea
+// format-lint-hooks): after an edit of a code or config file in a traced
+// repository, run the repository's static checks (its type checks, and a
+// linter or formatter check where package.json has one) on the working tree
+// and hand any failure back to the agent at once, so those errors never reach
+// review.
+//
+// It speaks only of failures that are its branch's own: a failure the branch's
+// base has too (checked once, on a clean checkout of the base) is left out, and
+// the same failures as last reported stay quiet, so an error the agent cannot
+// fix here does not repeat on every edit. Any input it does not expect, and any
+// failure of its own, says nothing.
+
+import { dirname, isAbsolute, join, relative, resolve } from 'node:path'
+
+import { baseOf, clip, compare, failureLines, finish, git, readInput, readJson, resultsAt, runCheck, scriptsOf, stateDir, tracedRepo, writeJson } from './common.mjs'
+
+const STATIC = ['typecheck', 'typecheck:mod', 'lint', 'format:check']
+const CODE = /\.(?:[cm]?[jt]sx?|json)$/i
+const PER_SCRIPT_MS = 90_000
+// Inside the hook's 300 s timeout in hooks.json, with room to clean up.
+const DEADLINE = Date.now() + 270_000
+
+// A script that is one plain `tsc` call (no build mode, no other commands).
+const PLAIN_TSC = /^\s*tsc\b(?![^;&|<>]*\s(?:-b|--build)\b)[^;&|<>`$]*$/
+
+/**
+ * The static checks, each as a command. A plain tsc script is told not to
+ * emit: these run in the agent's working tree, and a tsconfig without
+ * `noEmit` would otherwise write compiled files into the PR on every edit.
+ *
+ * @param {Record<string, string>} scripts @returns {string[]}
+ */
+const commandsOf = scripts => STATIC.filter(s => typeof scripts[s] === 'string')
+  .map(s => `npm run --silent ${JSON.stringify(s)}${PLAIN_TSC.test(scripts[s]) ? ' -- --noEmit' : ''}`)
+
+/** @param {any} input @returns {object | null} */
+function output(input) {
+  if (!input || !['Edit', 'Write', 'MultiEdit'].includes(input.tool_name)) return null
+  const raw = input.tool_input?.file_path
+  if (typeof raw !== 'string' || !CODE.test(raw)) return null
+  const cwd = typeof input.cwd === 'string' && isAbsolute(input.cwd) ? input.cwd : process.cwd()
+  const file = resolve(cwd, raw)
+  const root = tracedRepo(dirname(file)) ?? tracedRepo(cwd)
+  if (!root) return null
+  const rel = relative(root, file)
+  if (rel.startsWith('..') || isAbsolute(rel) || rel.split(/[\\/]/).includes('node_modules')) return null
+  const commands = commandsOf(scriptsOf(root))
+  if (!commands.length) return null
+
+  const now = []
+  for (const step of commands) {
+    const left = DEADLINE - Date.now()
+    if (left < 5_000) return null
+    const r = runCheck(step, root, Math.min(PER_SCRIPT_MS, left))
+    if (r.timedOut && left < PER_SCRIPT_MS) return null
+    now.push({ step, ok: r.ok, lines: r.ok ? [] : failureLines(r.output, root), tail: r.ok ? '' : r.output.trim() })
+  }
+  const state = stateDir(root)
+  const memo = state && join(state, 'static-last.json')
+  let red = now.filter(s => !s.ok).map(s => ({ ...s, fresh: s.lines }))
+  if (red.length && state) {
+    const head = git(['rev-parse', 'HEAD'], root)
+    const base = head && baseOf(root, head)
+    const atBase = base ? resultsAt(root, base, state, 'static', commandsOf, PER_SCRIPT_MS, DEADLINE) : null
+    if (atBase) red = compare(now, atBase.steps).red
+  }
+  const key = red.map(s => `${s.step}\0${s.fresh.join('\n')}`).join('\0\0')
+  const last = memo ? readJson(memo) : null
+  if (memo) writeJson(memo, { key })
+  if (!red.length || (last && last.key === key)) return null
+  const shown = red.map(s => `\`${s.step.replace(' --silent', '').replace(' -- --noEmit', '').replace(/"/g, '')}\` failed:\n${clip(s.tail, 3_000)}`).join('\n\n')
+  return {
+    decision: 'block',
+    reason: `Static checks after your edit of ${rel} (failures the branch's base also has are left out):\n\n${shown}\n\nFix these before review.`,
+  }
+}
+
+let out = null
+try {
+  out = output(readInput())
+} catch {
+  out = null
+}
+finish(out)
