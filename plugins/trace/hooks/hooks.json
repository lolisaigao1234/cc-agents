{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|NotebookRead|Grep|Glob|LS",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" pre-tool-use", "timeout": 30 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" post-tool-use", "timeout": 30 }]
      }
    ]
  }
}
